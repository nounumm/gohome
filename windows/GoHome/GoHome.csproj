<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>GoHome</AssemblyName>
    <RootNamespace>GoHome</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- WPF UI + WinForms NotifyIcon(트레이 아이콘)을 함께 쓴다. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!--
      ImplicitUsings 끔.
      WPF와 WinForms를 같이 켜면 Application/MessageBox/Color/Point/Brushes/Size 등이
      System.Windows 와 System.Windows.Forms 양쪽에 존재해 전부 모호성 에러가 난다.
      using 을 직접 쓰고 별칭으로 구분한다.
    -->
    <ImplicitUsings>disable</ImplicitUsings>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <!-- Pretendard. 설치 없이 앱에 내장해서 쓴다 (pack://application:,,,/Fonts/#패밀리명). -->
  <ItemGroup>
    <Resource Include="Fonts\Pretendard-Regular.otf" />
    <Resource Include="Fonts\Pretendard-Bold.otf" />
    <Resource Include="Fonts\Pretendard-SemiBold.otf" />
  </ItemGroup>

</Project>
