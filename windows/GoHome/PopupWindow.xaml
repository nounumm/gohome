<Window x:Class="GoHome.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="집에가자"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="pack://application:,,,/Fonts/#Pretendard"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Margin 은 그림자가 잘리지 않게 두는 여백 -->
    <Border x:Name="Card"
            Margin="14"
            CornerRadius="10"
            BorderThickness="1"
            Padding="16,12,16,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28"/>
        </Border.Effect>

        <!-- 화면 3개 중 하나만 보인다: 메인 / 출근 내역 / 설정 -->
        <StackPanel>

            <!-- ============ 메인 화면 ============ -->
            <StackPanel x:Name="MainPage">

                <!-- 헤더: 제목 + 기록/설정 아이콘 (macOS PopoverView 와 동일한 배치) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="집에가자"
                               FontFamily="pack://application:,,,/Fonts/#Pretendard SemiBold"
                               FontSize="13"/>
                    <!-- 누르면 포커스를 잃어도 안 닫히게 고정한다 -->
                    <TextBlock x:Name="PinIcon" Grid.Column="1" Text="📌"
                               FontSize="14" Opacity="0.35" Margin="0,0,10,0"
                               Cursor="Hand" MouseLeftButtonUp="PinIcon_Click"/>
                    <TextBlock Grid.Column="2" Text="🕐"
                               FontSize="14" Opacity="0.55" Margin="0,0,10,0"
                               Cursor="Hand" MouseLeftButtonUp="HistoryIcon_Click"/>
                    <TextBlock Grid.Column="3" Text="⚙"
                               FontSize="14" Opacity="0.55"
                               Cursor="Hand" MouseLeftButtonUp="SettingsIcon_Click"/>
                </Grid>

                <Border x:Name="HeaderDivider" Height="1" Margin="0,12,0,10"/>

                <!-- 현재 상태 -->
                <TextBlock Text="현재 상태" FontFamily="pack://application:,,,/Fonts/#Pretendard SemiBold" FontSize="10" Opacity="0.55"/>
                <TextBlock x:Name="StatusLabel" Margin="0,4,0,0"
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="RemainingLabel" Margin="0,3,0,0"
                           FontSize="11" Opacity="0.65" TextWrapping="Wrap"/>

                <!-- 출근 / 퇴근 시각: macOS TimeCard 와 동일하게 옅은 카드에 담는다 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CheckInCard" Grid.Column="0" CornerRadius="8" Padding="10,7">
                        <StackPanel>
                            <TextBlock Text="출근 시간" FontSize="10" Opacity="0.55"/>
                            <!-- 값을 누르면 그 자리에서 바로 수정된다 (TextBlock ↔ TextBox 전환) -->
                            <Grid Margin="0,2,0,0">
                                <TextBlock x:Name="CheckInValue"
                                           FontSize="20" FontWeight="Bold"
                                           Cursor="Hand"
                                           MouseLeftButtonUp="CheckInValue_Click"/>
                                <TextBox x:Name="CheckInEditBox"
                                         FontSize="20" FontWeight="Bold"
                                         Padding="0" BorderThickness="0" Background="Transparent"
                                         Visibility="Collapsed"
                                         KeyDown="CheckInEditBox_KeyDown"
                                         LostFocus="CheckInEditBox_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CheckOutCard" Grid.Column="2" CornerRadius="8" Padding="10,7">
                        <StackPanel>
                            <TextBlock x:Name="CheckOutCaption" Text="퇴근 예정"
                                       FontSize="10" Opacity="0.55"/>
                            <TextBlock x:Name="CheckOutValue" Margin="0,2,0,0"
                                       FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 반차 (macOS 버전의 캘린더 연동 대체) -->
                <CheckBox x:Name="HalfDayCheck"
                          Margin="0,12,0,0"
                          FontSize="12"
                          Content="오늘 반차 (4시간 근무)"
                          Click="HalfDayCheck_Click"/>

                <Border x:Name="ActionDivider" Height="1" Margin="0,12,0,10"/>

                <!-- 액션 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CheckInButton" Grid.Column="0"
                            Style="{StaticResource FlatButton}"
                            Content="출근하기"
                            Click="CheckInButton_Click"/>
                    <Button x:Name="CheckOutButton" Grid.Column="2"
                            Style="{StaticResource FlatButton}"
                            Content="퇴근하기"
                            Click="CheckOutButton_Click"/>
                </Grid>

            </StackPanel>

            <!-- ============ 출근 내역 화면 ============ -->
            <StackPanel x:Name="HistoryPage" Visibility="Collapsed">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="출근 내역" FontFamily="pack://application:,,,/Fonts/#Pretendard SemiBold" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="닫기"
                               FontSize="12" Opacity="0.55"
                               Cursor="Hand" MouseLeftButtonUp="CloseSubPage_Click"/>
                </Grid>

                <Border Height="1" Margin="0,12,0,0" Background="#22808080"/>

                <ScrollViewer MaxHeight="320" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Day}" FontSize="10" Opacity="0.55"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeRange}"
                                                       FontSize="13"/>
                                            <Border Grid.Column="1"
                                                    Visibility="{Binding BadgeVisibility}"
                                                    Background="{Binding BadgeBackground}"
                                                    CornerRadius="8" Padding="8,3">
                                                <TextBlock Text="{Binding BadgeText}"
                                                           FontSize="10"
                                                           Foreground="{Binding BadgeForeground}"/>
                                            </Border>
                                        </Grid>
                                        <Border Height="1" Margin="0,12,0,0" Background="#22808080"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="HistoryEmptyLabel" Text="출근 내역이 없습니다."
                                   FontSize="12" Opacity="0.5"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

            </StackPanel>

            <!-- ============ 설정 화면 ============ -->
            <StackPanel x:Name="SettingsPage" Visibility="Collapsed">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="설정" FontFamily="pack://application:,,,/Fonts/#Pretendard SemiBold" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="닫기"
                               FontSize="12" Opacity="0.55"
                               Cursor="Hand" MouseLeftButtonUp="CloseSubPage_Click"/>
                </Grid>

                <Border Height="1" Margin="0,12,0,0" Background="#22808080"/>

                <TextBlock Text="일반" FontFamily="pack://application:,,,/Fonts/#Pretendard SemiBold" FontSize="10" Opacity="0.55" Margin="0,16,0,8"/>
                <CheckBox x:Name="AutoStartCheck"
                          FontSize="13"
                          Content="로그인 시 자동 실행"
                          Click="AutoStartCheck_Click"/>

                <Border Height="1" Margin="0,16,0,12" Background="#22808080"/>

                <TextBlock Text="종료"
                           FontSize="13" Foreground="#EF4444"
                           Cursor="Hand" MouseLeftButtonUp="QuitLink_Click"/>

            </StackPanel>

        </StackPanel>
    </Border>
</Window>
